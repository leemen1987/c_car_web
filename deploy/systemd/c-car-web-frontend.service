[Unit]
Description=Charter Bus Scheduling Vite Frontend (Dev)
After=network.target

[Service]
Type=simple
User=xxb
Group=xxb
WorkingDirectory=/home/xxb/c_car_web/frontend
Environment=PATH=/home/xxb/.nvm/versions/node/v24.16.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/xxb/.nvm/versions/node/v24.16.0/bin/npm run dev -- --host 127.0.0.1 --port 5174
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
